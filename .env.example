# Copy this file to .env and fill in what you use. .env is git-ignored:
# never commit real webhook URLs or passwords.

# Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=

# Optional email alerts (STARTTLS). For Gmail/Outlook use an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
